{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping gateway :8010/metrics and ai_engine :8011/metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "PatentMind Q19 — AI 品質與成本 quality & cost: tokens by model (Q15 routing mix), LLM spend per tenant/model, verifier citation strip rate (Q14), tenant token-quota utilisation (Q18).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "schemaVersion": 39,
  "tags": ["patentmind", "q19", "quality", "cost"],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(oa_analyzed_total, tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "PatentMind — AI Quality & Cost (Q19 品質/成本層)",
  "uid": "patentmind-quality-cost",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM tokens by model (prompt vs completion, tokens/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (rate(llm_tokens_total[$__rate_interval]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Q15 router mix — calls per model (selected range)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(llm_route_total[$__range]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM errors by model (errors/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(llm_errors_total[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Month-to-date LLM spend per tenant + model (USD)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_cost_usd_month_to_date{tenant=~\"$tenant\"}",
          "legendFormat": "{{tenant}} / {{model}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cumulative LLM spend per tenant (USD)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (llm_cost_usd_total{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Verifier strip rate (Q14 — invalid / emitted citations)",
      "description": "Share of draft citations the independent verifier rejected as ungrounded and stripped. Rising = the reasoning model is hallucinating citations; the Q14 hard wall is absorbing it.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(citations_invalid_total[$__range])) / sum(increase(citations_total[$__range]))",
          "legendFormat": "strip rate"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Citations emitted vs stripped (Q14, per hour)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(citations_total[1h]))", "legendFormat": "emitted" },
        {
          "refId": "B",
          "expr": "sum(increase(citations_invalid_total[1h]))",
          "legendFormat": "stripped (ungrounded)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prompt-injection detections (Q11, per hour)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(prompt_injection_detected_total[1h]))",
          "legendFormat": "injection attempts"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Tenant token-quota utilisation (Q18, month-to-date)",
      "description": "tenant_monthly_tokens_used / tenant_monthly_token_cap. 100% = the tenant's monthly cap is exhausted and further analyze calls 429.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tenant_monthly_tokens_used{tenant=~\"$tenant\"} / on (tenant) tenant_monthly_token_cap",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "OAs analyzed per tenant (業務, per hour)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (increase(oa_analyzed_total{tenant=~\"$tenant\"}[1h]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    }
  ]
}
