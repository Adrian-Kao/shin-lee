# PatentMind environment template.
# Copy to `.env` and adjust. Vars marked [PROD] MUST be overridden in production.
# Every variable corresponds to one in backend/shared/config.py:Settings.

# ---------------------------------------------------------------------------
# Service ports / URLs
# ---------------------------------------------------------------------------
GATEWAY_PORT=8010
AI_ENGINE_PORT=8011
GATEWAY_URL=http://localhost:8010
AI_ENGINE_URL=http://localhost:8011

# ---------------------------------------------------------------------------
# Auth (Q12)
# ---------------------------------------------------------------------------
# [PROD] must be a random 32+ byte secret. Generate: openssl rand -hex 32
# Backend boot fails outside mock/test mode if this value is left as the placeholder.
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Upstream auth trust (Compat Refactor 3 — digiRunner migration prep)
# ---------------------------------------------------------------------------
# Comma-separated IPs that may set x-user-id / x-tenant-id / x-user-role
# headers (= digiRunner-validated identity). Anyone NOT from these IPs falls
# back to JWT auth. Default covers local dev + docker bridge network.
# WARNING: never widen to 0.0.0.0 / wildcards — that disables the spoofing
# guard entirely. Add the digiRunner pod IP / docker bridge gateway only.
# Plain IPs ONLY — CIDR notation (10.0.0.0/24) is rejected at boot.
TRUSTED_UPSTREAM_IPS=127.0.0.1,::1,172.17.0.1

# Defence-in-depth shared secret for upstream-trust auth. When set, requests
# claiming upstream identity MUST also carry a matching `x-upstream-auth-token`
# header or the upstream-trust path declines (= falls back to JWT).
# [PROD] REQUIRED when TRUSTED_UPSTREAM_IPS contains any non-loopback entry
# in non-mock mode. The backend refuses to boot if this guard is violated.
UPSTREAM_AUTH_SHARED_SECRET=

# ---------------------------------------------------------------------------
# LLM router (Q15)  mock | openai | anthropic | local
# ---------------------------------------------------------------------------
LLM_MODE=mock
LLM_MODEL_REASONING=claude-sonnet-mock
LLM_MODEL_CHEAP=haiku-mock
LLM_MODEL_LOCAL=llama3.1:8b
LLM_MODEL_VERIFIER=haiku-mock
# [PROD] required when LLM_MODE in (openai, anthropic)
LLM_API_KEY=
# [PROD] required when LLM_MODE=anthropic (in addition to LLM_API_KEY)
ANTHROPIC_API_KEY=

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TIMEOUT_SEC=600

# ---------------------------------------------------------------------------
# Cache (Q9)  memory | redis
# ---------------------------------------------------------------------------
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Vector store (Q7)  memory | qdrant
# ---------------------------------------------------------------------------
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Embedding (Q5/Q7)  mock | bge-m3
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=mock
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Storage (Q13 audit archive / Q20 backups)  AUDIT_BACKEND: sqlite | postgres
# ---------------------------------------------------------------------------
AUDIT_BACKEND=sqlite
# [PROD] override password and host. Used by AUDIT_BACKEND=postgres.
POSTGRES_URL=postgresql://patentmind:patentmind@localhost:5432/patentmind

# Optional: used by docker-compose.yml when starting the local Postgres container.
POSTGRES_DB=patentmind
POSTGRES_USER=patentmind
POSTGRES_PASSWORD=patentmind

# ---------------------------------------------------------------------------
# PDF upload (Day 2)
# ---------------------------------------------------------------------------
# Max upload size in megabytes — gateway rejects larger bodies with 413.
MAX_UPLOAD_MB=30
# A PDF page producing fewer than this many extracted-text chars is treated as
# a scanned page and routed through Claude Vision OCR.
MIN_CHARS_PER_PAGE_FOR_TEXT=30
# Max concurrent Vision OCR calls per upload. Cap protects rate limits + cost.
OCR_PARALLELISM=4

# ---------------------------------------------------------------------------
# AI Engine prompt introspection (Compat Refactor 1)
# ---------------------------------------------------------------------------
# Controls GET /v1/prompts and GET /v1/prompts/{intent} on the AI Engine.
# These endpoints expose our externalized system-prompts (used by Dify import
# + dev sanity checks). AI Engine has no per-endpoint auth — it's intra-VPC
# only — so prod operators who don't want the prompts reachable even from
# inside the VPC should set this to false. The endpoints then return 404.
# [PROD] consider setting to "false" once Dify import is complete.
EXPOSE_PROMPT_API=true

# ---------------------------------------------------------------------------
# Observability (Day 5 — Sentry; no-op when DSN is unset)
# ---------------------------------------------------------------------------
# Backend (gateway + ai_engine) — both services tag events with `service`.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
# Frontend (vite-exposed; MUST be VITE_ prefix). Use a SEPARATE Sentry project
# from the backend so attendee browsers can't write to the backend project key.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=dev
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Legacy OCR/RAG CLI (ocr_rag_cli/) — kept for backward compatibility.
# Safe to ignore unless you actually run the OCR prototype.
# ---------------------------------------------------------------------------
QDRANT_COLLECTION=ocr_rag_documents
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
TOP_K=5
