{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "PatentMind gateway + ai_engine /metrics scrape target",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Q19 four-layer observability for PatentMind: 系統 (system) / 品質 (quality) / 業務 (business) / 成本 (cost). Scrapes gateway:8010/metrics and ai_engine:8011/metrics.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["patentmind", "q19", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(oa_analyzed_total, tenant)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "title": "PatentMind — Q19 Observability (4-layer)",
  "uid": "patentmind-q19",
  "panels": [
    {
      "type": "row",
      "title": "系統 System",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request latency p50/p95/p99 by endpoint (s)",
      "description": "histogram_quantile over http_request_duration_seconds. The audit-write SLO line sits separately at 0.1s (next panel).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{endpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audit-write latency p99 (SLO < 0.1s)",
      "description": "Invariant #4 SLO: audit write must stay sub-100ms or the frontend stalls. Red threshold at 0.1s.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(audit_write_duration_seconds_bucket[5m])))",
          "legendFormat": "audit p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate by status (req/s)",
      "description": "Request rate split by HTTP status. 4xx/5xx are the alert surface.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM errors (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_errors_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "品質 Quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "stat",
      "title": "Citation hallucination rate (5m)",
      "description": "citations_invalid_total / citations_total — fraction of draft citations that failed grounding verification (Q14).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(citations_invalid_total[5m])) / clamp_min(sum(rate(citations_total[5m])), 1)",
          "legendFormat": "hallucination rate"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prompt-injection attempts detected (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "targets": [
        {
          "expr": "sum(rate(prompt_injection_detected_total[5m]))",
          "legendFormat": "injections/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Citations emitted vs invalid (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "targets": [
        { "expr": "sum(rate(citations_total[5m]))", "legendFormat": "emitted" },
        { "expr": "sum(rate(citations_invalid_total[5m]))", "legendFormat": "invalid" }
      ]
    },
    {
      "type": "row",
      "title": "業務 Business",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "timeseries",
      "title": "OA analyzed (rate) by tenant",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(oa_analyzed_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Exports: signed-off vs refused (rate)",
      "description": "exports_total split by signed_off; signoff_refused_total is the hard-gate refusal count (Q16).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "expr": "sum by (signed_off) (rate(exports_total[5m]))",
          "legendFormat": "signed_off={{signed_off}}"
        },
        {
          "expr": "sum(rate(signoff_refused_total[5m]))",
          "legendFormat": "refused (hard gate)"
        }
      ]
    },
    {
      "type": "row",
      "title": "成本 Cost",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "type": "timeseries",
      "title": "LLM month-to-date spend (USD) by tenant",
      "description": "llm_cost_usd_month_to_date gauge, bridged read-only from the rate_limit accounting layer.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "expr": "sum by (tenant) (llm_cost_usd_month_to_date)",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM token throughput by model (tokens/s)",
      "description": "llm_tokens_total split prompt/completion per model; llm_route_total shows the router mix (local↔cloud↔cheap).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 },
      "targets": [
        {
          "expr": "sum by (model, kind) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM route mix (calls/s by model)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_route_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    }
  ]
}
